# Copy to backend/.env (never commit .env). DUMMY VALUES ONLY in this file.

# LLM provider: mock | amd_token_factory   (amd_vllm / gemini are reserved, not connected)
LLM_PROVIDER=mock
LLM_TIMEOUT_S=60
LLM_MAX_CASES=5

# AMD Token Factory (Member 2). Only needed when LLM_PROVIDER=amd_token_factory.
# VERIFY: copy the Base URL and model exactly as the AMD Token Factory dashboard shows them (HTTPS only).
AMD_TOKEN_FACTORY_API_KEY=replace-me-dummy-key
AMD_TOKEN_FACTORY_BASE_URL=https://VERIFY-from-AMD-dashboard/v1
AMD_TOKEN_FACTORY_MODEL=VERIFY-from-AMD-dashboard

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Optional: also allow origins matching this regex (e.g. Vercel preview deployments)
FRONTEND_ORIGIN_REGEX=

MAX_UPLOAD_MB=10
MAX_RUNS=20
