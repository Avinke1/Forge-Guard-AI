# Copy to backend/.env (never commit .env). DUMMY VALUES ONLY in this file.

# LLM provider: amd_vllm | gemini | mock
LLM_PROVIDER=mock
# vLLM OpenAI-compatible server on the AMD droplet, e.g. http://<AMD-droplet-ip>:8000/v1
LLM_BASE_URL=http://127.0.0.1:8000/v1
# The vLLM --api-key value (or the Gemini key when LLM_PROVIDER=gemini)
LLM_API_KEY=replace-me-dummy-key
# VERIFY the model actually loads on the server; fallback Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VERIFY: copy the GPU name exactly as the AMD Developer Cloud dashboard shows it
LLM_HARDWARE_LABEL=VERIFY-from-AMD-dashboard
LLM_TIMEOUT_S=60
LLM_MAX_CASES=5

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

MAX_UPLOAD_MB=10
MAX_RUNS=20
