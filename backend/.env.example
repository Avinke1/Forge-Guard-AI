# Copy to backend/.env (never commit .env). DUMMY VALUES ONLY in this file.
# The LLM_* lines are read by backend/app/llm_client.py.

# mock (no AI, no network) | amd_token_factory (real AI on AMD) | saved (only saved AMD reports) | gemini (optional backup)
LLM_PROVIDER=mock
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# The team's AMD Token Factory key - ONLY in backend/.env, never in Git, chat or screenshots
LLM_API_KEY=rc-REPLACE_ME
LLM_MODEL=DeepSeek-V4-Flash
LLM_FALLBACK_MODEL=MiMo-V2.6-Flash
LLM_HARDWARE_LABEL=AMD GPUs - AMD Token Factory (Radeon Cloud)
LLM_TIMEOUT_S=60
LLM_MAX_CASES=5
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Optional: also allow origins matching this regex (e.g. Vercel preview deployments)
FRONTEND_ORIGIN_REGEX=

MAX_UPLOAD_MB=10
MAX_RUNS=20
